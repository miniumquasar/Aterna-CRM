<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AETERNA CRM on macOS, with the hardened runtime that notarisation needs.
  Electron's JavaScript engine compiles code as it runs, so it needs JIT. Nothing
  else is asked for: no camera, microphone, contacts or location, and no sandbox
  exceptions (the app is distributed outside the Mac App Store).
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
