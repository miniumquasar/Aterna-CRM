{
  "name": "aeterna-crm",
  "productName": "AETERNA CRM",
  "version": "1.0.0",
  "description": "AETERNA CRM: an offline desktop app for UK accounting practices",
  "main": "out/main/index.js",
  "author": "Bitopi",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://bitopi.co.uk/",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "node scripts/electron-node.mjs node_modules/vitest/vitest.mjs run",
    "build": "npm run typecheck && npm run lint && npm test && electron-vite build",
    "smoke": "node scripts/smoke.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "licence": "tsx tools/licence-generator/cli.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "better-sqlite3-multiple-ciphers": "12.11.1",
    "exceljs": "4.4.0",
    "framer-motion": "11.18.2",
    "lucide-react": "1.52.0",
    "nodemailer": "10.0.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "electron": "41.2.1",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "30.1.2",
    "playwright": "1.63.0",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
